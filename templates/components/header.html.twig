
<nav class="w-full bg-gray-900 shadow-2xl border-b border-blue-500/25 backdrop-blur-lg" {{ attributes }}>
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-between py-3">
            <div class="flex-shrink-0">
                <div class="bg-gradient-to-br from-blue-500 to-purple-600 px-4 py-3 rounded-2xl shadow-lg
                           transition-all duration-300 ease-out hover:scale-105 hover:-translate-y-1
                           hover:shadow-blue-500/30 hover:shadow-xl cursor-pointer group relative overflow-hidden">
                    <i class="bi bi-flask-fill text-2xl text-white relative z-10
                             transition-transform duration-300 group-hover:rotate-6
                             drop-shadow-lg"></i>
                    <div class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100
                               transition-opacity duration-300"></div>
                </div>
            </div>

            <div class="flex items-center space-x-4">
                {% if user is null %}
                    <a href="{{ path('github_connect') }}"
                       class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-green-600
                              text-white font-semibold rounded-full shadow-lg transition-all duration-300
                              hover:-translate-y-1 hover:shadow-green-500/30 hover:shadow-xl
                            ">
                        <i class="bi bi-github text-xl mr-2"></i>
                        <span>Connexion GitHub</span>
                    </a>
                {% else %}
                    <div class="relative">
                        <button {{ live_action('toggle') }}
                            class="flex items-center space-x-3 px-4 py-2 bg-gray-800/50 border border-gray-600
                                       rounded-full shadow-lg backdrop-blur-sm transition-all duration-300
                                       hover:bg-gray-700/50 hover:border-blue-500 hover:-translate-y-0.5
      "
                            aria-expanded="{{ isOpen ? 'true' : 'false' }}"
                            aria-haspopup="true"
                            type="button">

                            <div class="relative">
                                <img src="{{ user.profilePicture }}"
                                     width="40" height="40"
                                     class="w-10 h-10 rounded-full border-2 {{ isOpen ? 'border-blue-500' : 'border-white/20' }}
                                            shadow-md object-cover transition-all duration-300"
                                     alt="Avatar {{ user.name }}"
                                  >
                                <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-green-500 rounded-full
                                           border-2 border-gray-900"></span>
                            </div>

                            <div class="hidden md:block text-left">
                                <div class="text-white font-medium text-sm transition-colors duration-300">
                                    {{ user.name }}
                                </div>
                                <div class="text-gray-400 text-xs">Connecté</div>
                            </div>
                            <i class="bi {{ isOpen ? 'bi-chevron-up' : 'bi-chevron-down' }} text-gray-400 text-xs
                                     transition-all duration-300 {{ isOpen ? 'rotate-180' : '' }}"></i>
                        </button>


                        {% if isOpen is true %}
                            <div class="absolute right-0 mt-3 w-80 bg-gray-900/95 border border-gray-700 rounded-2xl
                                       shadow-2xl backdrop-blur-xl z-50 overflow-hidden animate-in slide-in-from-top-2
                                       duration-300">
                                <div class="bg-gradient-to-r from-blue-600 to-purple-600 p-6 text-center">
                                    <div class="flex items-center justify-center space-x-4">
                                        <img src="{{ user.profilePicture }}"
                                             width="60" height="60"
                                             class="w-15 h-15 rounded-full border-4 border-white/20 shadow-lg object-cover"
                                             alt="Avatar {{ user.name }}">
                                        <div class="text-left">
                                            <h3 class="text-white font-bold text-lg">{{ user.name }}</h3>
                                            <p class="text-white/70 text-sm">{{ user.email }}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-3 space-y-1">
                                    <div class="flex items-center p-3 rounded-xl transition-all duration-200
                                               hover:bg-white/5 hover:translate-x-1 cursor-pointer group">
                                        <i class="bi bi-person text-blue-400 text-xl mr-4 group-hover:scale-110
                                                 transition-transform duration-200"></i>
                                        <div class="flex-1">
                                            <div class="text-white font-medium">Mon Profil</div>
                                            <div class="text-gray-400 text-sm group-hover:text-gray-300
                                                       transition-colors duration-200">Gérer mes informations</div>
                                        </div>
                                    </div>

                                    <div class="flex items-center p-3 rounded-xl transition-all duration-200
                                               hover:bg-white/5 hover:translate-x-1 cursor-pointer group">
                                        <i class="bi bi-folder text-yellow-400 text-xl mr-4 group-hover:scale-110
                                                 transition-transform duration-200"></i>
                                        <div class="flex-1">
                                            <div class="text-white font-medium">Mes Projets</div>
                                            <div class="text-gray-400 text-sm group-hover:text-gray-300
                                                       transition-colors duration-200">Gérer les projets</div>
                                        </div>
                                    </div>

                                    <div class="flex items-center p-3 rounded-xl transition-all duration-200
                                               hover:bg-white/5 hover:translate-x-1 cursor-pointer group">
                                        <i class="bi bi-gear text-gray-400 text-xl mr-4 group-hover:scale-110
                                                 transition-transform duration-200"></i>
                                        <div class="flex-1">
                                            <div class="text-white font-medium">Paramètres</div>
                                            <div class="text-gray-400 text-sm group-hover:text-gray-300
                                                       transition-colors duration-200">Préférences</div>
                                        </div>
                                    </div>

                                    <hr class="border-gray-700 my-3">

                                    <div class="flex items-center p-3 rounded-xl transition-all duration-200
                                               hover:bg-white/5 hover:translate-x-1 cursor-pointer group">
                                        <i class="bi bi-question-circle text-green-400 text-xl mr-4 group-hover:scale-110
                                                 transition-transform duration-200"></i>
                                        <div class="text-white font-medium">Aide</div>
                                    </div>

                                    <div class="flex items-center p-3 rounded-xl transition-all duration-200
                                               hover:bg-red-500/10 hover:translate-x-1 cursor-pointer group">
                                        <i class="bi bi-box-arrow-right text-red-400 text-xl mr-4 group-hover:scale-110
                                                 transition-transform duration-200"></i>
                                        <div class="text-red-400 font-medium">Déconnexion</div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
