<div {{ attributes }} class="relative z-50">

    <button
        class="bg-gray-900/80 backdrop-blur-lg p-3 rounded-lg absolute bottom-4 left-4 cursor-pointer hover:bg-gray-800/80 transition-all duration-300 shadow-lg border border-gray-700/50"
        {{ live_action('toggle') }}>
        {% if isOpen is true %}
            {{ ux_icon('bi:x-lg', { 'style': 'width:20px;height:20px;color:white;' }) }}
        {% else %}
            {{ ux_icon('bi:list', { 'style': 'width:20px;height:20px;color:white;' }) }}
        {% endif %}
    </button>

    {% if isOpen is true %}

        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm lg:hidden" {{ live_action('toggle') }}></div>

        <div
            class="fixed left-0 top-0 h-full w-80 bg-gradient-to-br from-slate-900 via-blue-900/90 to-purple-900/90 backdrop-blur-xl shadow-2xl border-r border-gray-700/30 flex flex-col z-50 transform transition-transform duration-300">


            <div class="p-6 border-b border-gray-700/30">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-bold text-white flex items-center">
                        {{ ux_icon('bi:grid-3x3-gap', { 'style': 'width:24px;height:24px;margin-right:12px;color:#60a5fa;' }) }}
                        Navigation
                    </h2>
                    <button class="p-2 hover:bg-gray-700/50 rounded-lg transition-colors" {{ live_action('toggle') }}>
                        {{ ux_icon('bi:x-lg', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </button>
                </div>
            </div>


            <nav class="flex-1 p-4 space-y-2">
                <div
                    class="flex items-center px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700/30 rounded-lg transition-all duration-200 group">
                    {{ ux_icon('bi:speedometer2', { 'style': 'width:20px;height:20px;margin-right:12px;color:#60a5fa;' }) }}
                    <span class="font-medium">Tableau de bord</span>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                        {{ ux_icon('bi:arrow-right', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </div>
                </div>
                <div
                    class="flex items-center px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700/30 rounded-lg transition-all duration-200 group">
                    {{ ux_icon('bi:people', { 'style': 'width:20px;height:20px;margin-right:12px;color:#34d399;' }) }}
                    <span class="font-medium">Utilisateurs</span>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                        {{ ux_icon('bi:arrow-right', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </div>
                </div>
                <div
                    class="flex items-center px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700/30 rounded-lg transition-all duration-200 group">
                    {{ ux_icon('bi:box', { 'style': 'width:20px;height:20px;margin-right:12px;color:#f59e0b;' }) }}
                    <span class="font-medium">Produits</span>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                        {{ ux_icon('bi:arrow-right', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </div>
                </div>
                <div
                    class="flex items-center px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700/30 rounded-lg transition-all duration-200 group">
                    {{ ux_icon('bi:cart', { 'style': 'width:20px;height:20px;margin-right:12px;color:#8b5cf6;' }) }}
                    <span class="font-medium">Commandes</span>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                        {{ ux_icon('bi:arrow-right', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </div>
                </div>
                <div
                    class="flex items-center px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700/30 rounded-lg transition-all duration-200 group">
                    {{ ux_icon('bi:bar-chart', { 'style': 'width:20px;height:20px;margin-right:12px;color:#ef4444;' }) }}
                    <span class="font-medium">Statistiques</span>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                        {{ ux_icon('bi:arrow-right', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </div>
                </div>

                <div class="border-t border-gray-700/30 my-4"></div>

                <div
                    class="flex items-center px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700/30 rounded-lg transition-all duration-200 group">
                    {{ ux_icon('bi:gear', { 'style': 'width:20px;height:20px;margin-right:12px;color:#6b7280;' }) }}
                    <span class="font-medium">Paramètres</span>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                        {{ ux_icon('bi:arrow-right', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </div>
                </div>
                <div
                    class="flex items-center px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700/30 rounded-lg transition-all duration-200 group">
                    {{ ux_icon('bi:question-circle', { 'style': 'width:20px;height:20px;margin-right:12px;color:#06b6d4;' }) }}
                    <span class="font-medium">Support</span>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                        {{ ux_icon('bi:arrow-right', { 'style': 'width:16px;height:16px;color:#9ca3af;' }) }}
                    </div>
                </div>
            </nav>
        </div>
    {% endif %}
</div>
