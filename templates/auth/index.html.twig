{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div
        class=" flex items-center justify-center p-4 mt-4">
        <div class="w-full max-w-md">

            <div
                class="bg-gradient-to-br from-gray-900 via-blue-900 to-purple-900 backdrop-blur-xl rounded-2xl shadow-2xl border border-gray-700 overflow-hidden p-4">

                <p class="text-gray-300 text-4xl text-center mb-4">Connectez-vous</p>

                {{ form_start(loginForm, { 'attr': { 'class': 'p-6 space-y-6' } }) }}

                <div>
                    {{ form_label(loginForm.email, null, { 'label_attr': { 'class': 'block text-gray-300 mb-1' } }) }}
                    {{ form_widget(loginForm.email, { 'attr': { 'class': 'w-full px-4 py-2 rounded-lg bg-gray-800 text-white border border-gray-600 focus:ring-2 focus:ring-blue-500' } }) }}
                    {{ form_errors(loginForm.email) }}
                </div>

                <div>
                    {{ form_label(loginForm.password, null, { 'label_attr': { 'class': 'block text-gray-300 mb-1' } }) }}
                    {{ form_widget(loginForm.password, { 'attr': { 'class': 'w-full px-4 py-2 rounded-lg bg-gray-800 text-white border border-gray-600 focus:ring-2 focus:ring-blue-500' } }) }}
                    {{ form_errors(loginForm.password) }}
                </div>

                <div class="flex items-center">
                    {{ form_widget(loginForm.rememberMe, { 'attr': { 'class': 'h-4 w-4 text-blue-600 border-gray-600 rounded focus:ring-blue-500' } }) }}
                    {{ form_label(loginForm.rememberMe, null, { 'label_attr': { 'class': 'ml-2 text-gray-300' } }) }}
                </div>

                <button type="submit"
                        class="w-full py-2 px-4 bg-blue-600 hover:bg-blue-700 rounded-lg text-white font-semibold shadow-md">
                    Connexion
                </button>

                {{ form_end(loginForm) }}

                <div class="flex items-center my-6">
                    <div class="flex-grow h-px bg-white"></div>
                    <span class="px-3 text-white text-sm">ou</span>
                    <div class="flex-grow h-px bg-white"></div>
                </div>


                <div class="space-y-3">
                    <a
                        href="{{ path('github_connect') }}"
                        class="flex cursor-pointer items-center justify-center w-full py-2 px-4 bg-gray-800 hover:bg-gray-700 rounded-lg text-white font-semibold shadow-md transition">

                        {{ ux_icon('bi:github', { 'style': 'width:20px;height:20px;margin-right:8px;' }) }}
                        Continuer avec GitHub
                    </a>

                    <div
                        class="flex cursor-pointer items-center justify-center w-full py-2 px-4 bg-white hover:bg-gray-100 rounded-lg text-gray-800 font-semibold shadow-md transition">

                        {{ ux_icon('bi:google', { 'style': 'width:20px;height:20px;margin-right:8px;' }) }}
                        Continuer avec Google
                    </div>

                    <div
                        class="flex cursor-pointer items-center justify-center w-full py-2 px-4 bg-blue-600 hover:bg-blue-700 rounded-lg text-white font-semibold shadow-md transition">
                        {{ ux_icon('bi:microsoft', { 'style': 'width:20px;height:20px;margin-right:8px;' }) }}
                        Continuer avec Microsoft
                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}

