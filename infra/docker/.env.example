# Copy to infra/docker/.env before running `docker compose up`.

POSTGRES_VERSION=16
POSTGRES_USER=towelie
POSTGRES_PASSWORD=towelie
POSTGRES_DB=towelie
DB_PORT=5432

BACKEND_PORT=8000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
CORS_ALLOW_ORIGIN=http://localhost:3000

# Bootstrap Super-Admin account, created on first boot only
SEED_SUPERADMIN_EMAIL=admin@towelie.test
SEED_SUPERADMIN_PASSWORD=change-me-please-a-strong-password
SEED_SUPERADMIN_FIRSTNAME=Towelie
SEED_SUPERADMIN_LASTNAME=Admin

WEBSITE_PORT=3000
API_URL=http://localhost:8000
