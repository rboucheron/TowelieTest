PORT=8000
DATABASE_URL=postgresql://towelie:towelie@localhost:5432/towelie
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
CORS_ALLOW_ORIGIN=http://localhost:3000
NODE_ENV=development

# GitHub sign-in (optional). Create an OAuth App at https://github.com/settings/developers
# with the callback URL below; leave the id/secret empty to disable the "Continue with GitHub" button.
FRONTEND_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/v1/auth/github/callback

# Bootstrap super-admin, consumed only by `bun run seed`
SEED_SUPERADMIN_EMAIL=admin@towelie.test
SEED_SUPERADMIN_PASSWORD=change-me-please-a-strong-password
SEED_SUPERADMIN_FIRSTNAME=Towelie
SEED_SUPERADMIN_LASTNAME=Admin
